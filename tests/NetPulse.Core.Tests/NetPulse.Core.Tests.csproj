<Project Sdk="Microsoft.NET.Sdk">
  <!-- 순수 로직 테스트. Windows·UI 없음. CI 필수. Microsoft Testing Platform으로 돈다 (global.json). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\NetPulse.Core\NetPulse.Core.csproj" />
    <!-- 배포에 들어가는 데모 시나리오가 모두 유효한지 검사한다 -->
    <None Include="..\..\demo\scenarios\*.json" Link="scenarios\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
