<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NetPulse · 네트워크 모니터" Width="1152" Height="745" MinWidth="970" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#F5F6F8" FontSize="14" Foreground="#202124"
        Language="ko-KR" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="47" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="14"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#202124"/>
    <SolidColorBrush x:Key="Muted" Color="#555A64"/>
    <SolidColorBrush x:Key="Accent" Color="#005DBF"/>
    <SolidColorBrush x:Key="Blue" Color="#0067D8"/>
    <LinearGradientBrush x:Key="Backdrop" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FBFBFC" Offset="0"/>
      <GradientStop Color="#F2F4F7" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F9FFFFFF" Offset="0"/>
      <GradientStop Color="#DFFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassEdge" Color="#E2E5EA"/>
    <Style x:Key="Glass" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource GlassFill}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="15"/>
      <Setter Property="Padding" Value="19"/>

    </Style>
    <Style x:Key="Action" TargetType="Button">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="15,8"/>
      <Setter Property="MinHeight" Value="37"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="8" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.86"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#3989E8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Mode" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Face" CornerRadius="8" Background="Transparent" Padding="14,7"
                    BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#72FFFFFF"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Face" Property="Background" Value="#F6FFFFFF"/>
                <Setter TargetName="Face" Property="BorderBrush" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#3989E8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.62"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#EDF0F4"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#E3E8EE"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ProgressStyle" TargetType="ProgressBar">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="3" Background="#E8EBEF"/>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Blue}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="28">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grip" CornerRadius="3" Background="#7E9EA7B3" Margin="2,1,3,1"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#A08A94A0"/></Trigger>
                          <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#BC6B7685"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GlassCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="#FAFBFC"/>
      <Setter Property="MinHeight" Value="39"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EBF1FA"/></Trigger>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#DCE9F9"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="ComboFace" Background="{TemplateBinding Background}" BorderBrush="{StaticResource GlassEdge}"
                      BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}">
                <Grid>
                  <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    VerticalAlignment="Center" Margin="0,0,18,0" IsHitTestVisible="False"/>
                  <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource Muted}" StrokeThickness="1.3"
                        StrokeLineJoin="Round" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
              </Border>
              <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="Fade">
                <Border Background="#FAFBFD" CornerRadius="11" BorderBrush="#E0E4EA" BorderThickness="1"
                        Margin="0,3,0,0" Padding="4" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFace" Property="BorderBrush" Value="#3989E8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboFace" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SidebarButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="9,8"/>
      <Setter Property="MinHeight" Value="37"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="7"
                    Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#E7EBF0"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Row" Property="Background" Value="#DDE5EF"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#3989E8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.46"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavIcon" TargetType="Path">
      <Setter Property="Stroke" Value="#496278"/>
      <Setter Property="StrokeThickness" Value="1.35"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Width" Value="15"/>
      <Setter Property="Height" Value="15"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>
  <Border BorderBrush="#D8DCE2" BorderThickness="1">
    <Grid Background="{StaticResource Backdrop}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="177"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="47"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Grid.RowSpan="2" Background="#DDEEF0F3" BorderBrush="#E0E3E8" BorderThickness="0,0,1,0"/>
      <StackPanel Orientation="Horizontal" Margin="17,0,0,0" VerticalAlignment="Center">
        <Border Width="25" Height="25" Background="{StaticResource Blue}" CornerRadius="7">
          <Path Data="M 0 5 L 3 5 L 5 1 L 8 9 L 10 5 L 14 5" Stroke="White" StrokeThickness="1.3"
                StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="NetPulse" FontWeight="Bold" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="최소화" AutomationProperties.Name="최소화"/>
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="최대화 / 복원" AutomationProperties.Name="최대화 / 복원"/>
        <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Content="&#xE8BB;" ToolTip="닫기" AutomationProperties.Name="닫기"/>
      </StackPanel>
      <DockPanel Grid.Row="1" Margin="11,16,11,16">
        <Button x:Name="FolderButton" Style="{StaticResource SidebarButton}" DockPanel.Dock="Bottom" AutomationProperties.Name="결과 폴더">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource NavIcon}" Data="M1,13 V3 H6 L8,5 H15 V13 Z"/>
            <TextBlock Text="결과 폴더"/>
          </StackPanel>
        </Button>
        <StackPanel>
          <Border Background="#DDE8F5" CornerRadius="7" Padding="10,9" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource NavIcon}" Stroke="{StaticResource Accent}" Data="M1,8 H4 L6,3 L9,12 L11,7 H15"/>
              <TextBlock Text="모니터" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
            </StackPanel>
          </Border>
          <Button x:Name="QuickButton" Style="{StaticResource SidebarButton}" AutomationProperties.Name="빠른 진단">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource NavIcon}" Data="M8,1 L2,9 H7 L7,15 L14,6 H9 Z"/>
              <TextBlock Text="빠른 진단"/>
            </StackPanel>
          </Button>
          <Button x:Name="AnalysisButton" Style="{StaticResource SidebarButton}" AutomationProperties.Name="끊김 분석">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource NavIcon}" Data="M1,14 V2 M1,14 H15 M4,10 L8,6 L11,9 L15,3"/>
              <TextBlock Text="끊김 분석"/>
            </StackPanel>
          </Button>
          <Button x:Name="CompareButton" Style="{StaticResource SidebarButton}" AutomationProperties.Name="결과 비교">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource NavIcon}" Data="M3,14 V8 M8,14 V3 M13,14 V6"/>
              <TextBlock Text="결과 비교"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>

      <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/></ScrollViewer.Resources>
        <StackPanel Margin="33,12,33,23">
          <DockPanel Margin="1,0,1,23">
            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Padding="10,6" CornerRadius="11"
                    Background="#F4F5F7" BorderThickness="1" BorderBrush="{StaticResource GlassEdge}">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StateDot" Width="6" Height="6" Fill="#8B929B" Margin="0,0,7,0"/>
                <TextBlock x:Name="StateText" Text="대기 중" FontWeight="SemiBold" FontSize="12"/>
              </StackPanel>
            </Border>
            <StackPanel>
              <TextBlock Text="네트워크 모니터" FontSize="36" FontWeight="Bold"/>
              <TextBlock Text="Mesh 경유와 직접 Wi‑Fi에서 지연과 손실을 기록합니다."
                         Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
            </StackPanel>
          </DockPanel>
          <Border Style="{StaticResource Glass}" Padding="16,13" Margin="0,0,0,23">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="연결 방식" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="1,0,0,6"/>
                  <Border Background="#EBEDF1" CornerRadius="9" Padding="2">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="MeshMode" GroupName="Mode" IsChecked="True" Style="{StaticResource Mode}" Content="Mesh 경유"/>
                      <RadioButton x:Name="WifiMode" GroupName="Mode" Style="{StaticResource Mode}" Content="직접 Wi‑Fi"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                  <TextBlock Text="측정 시간" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="1,0,0,6"/>
                  <StackPanel Orientation="Horizontal">
                    <Border Background="White" CornerRadius="8" Padding="4,3" Height="36" BorderThickness="1" BorderBrush="{StaticResource GlassEdge}">
                      <TextBox x:Name="MinutesBox" Width="40" Text="10" MaxLength="3" BorderThickness="0" Background="Transparent"
                               FontSize="15" FontWeight="SemiBold" TextAlignment="Center" VerticalContentAlignment="Center"
                               AutomationProperties.Name="측정 시간 (분)"/>
                    </Border>
                    <TextBlock Text="분" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                  <Button x:Name="MarkButton" Style="{StaticResource Action}" Content="증상 표시" IsEnabled="False" Margin="0,0,6,0"
                          ToolTip="끊김을 체감한 시각을 현재 측정에 저장합니다."/>
                  <Button x:Name="StopButton" Style="{StaticResource Action}" Content="중지 및 저장" IsEnabled="False" Margin="0,0,6,0"/>
                  <Button x:Name="StartButton" Style="{StaticResource Action}" Background="{StaticResource Blue}"
                          Foreground="White" MinWidth="94" BorderBrush="{StaticResource Blue}" Content="측정 시작"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="ModeHint" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="1,9,0,0"/>
            </StackPanel>
          </Border>
          <DockPanel LastChildFill="False" Margin="1,0,1,10">
            <TextBlock DockPanel.Dock="Left" Text="실시간 측정" FontSize="18" FontWeight="Bold"/>
            <TextBlock DockPanel.Dock="Right" Text="1초 간격  ·  최근 60초" FontSize="12.5"
                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          </DockPanel>
          <Grid x:Name="CardsHost" Margin="0,0,0,15"/>
          <Border Style="{StaticResource Glass}" Padding="16,12" Margin="0,0,0,9">
            <StackPanel>
              <DockPanel>
                <TextBlock x:Name="ElapsedText" DockPanel.Dock="Right" Text="00:00 / 10:00" Foreground="{StaticResource Accent}" FontSize="14"
                           FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="RoundsText" Text="측정 대기 중" FontWeight="SemiBold" FontSize="13"/>
              </DockPanel>
              <ProgressBar x:Name="Progress" Style="{StaticResource ProgressStyle}" Height="5" Margin="0,8,0,7" Minimum="0" Maximum="100"/>
              <TextBlock x:Name="DetailText" Text="손실이 감지되면 마지막 손실 시각과 대상을 표시합니다."
                         FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="SaveText" Text="측정이 끝나면 끊김 분석에서 회차와 링크 기록을 확인할 수 있습니다."
                     FontSize="12" Foreground="{StaticResource Muted}" Margin="1,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
