<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NetPulse · 네트워크 모니터" Width="1072" Height="773" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#EDF3FB" FontSize="14" Foreground="#192238"
        Language="ko-KR" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="47" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="14"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#192238"/>
    <SolidColorBrush x:Key="Muted" Color="#526078"/>
    <SolidColorBrush x:Key="Accent" Color="#234DBD"/>
    <LinearGradientBrush x:Key="Backdrop" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F8FAFF" Offset="0"/>
      <GradientStop Color="#EDF2FC" Offset="0.48"/>
      <GradientStop Color="#EEF2FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#DFFFFFFF" Offset="0"/>
      <GradientStop Color="#9EFFFFFF" Offset="0.64"/>
      <GradientStop Color="#72F4F7FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0.7,1">
      <GradientStop Color="White" Offset="0"/>
      <GradientStop Color="#EBFFFFFF" Offset="0.55"/>
      <GradientStop Color="#8FFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Blue" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#476FF0" Offset="0"/>
      <GradientStop Color="#264BC5" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="GlassShadow" Color="#6881AE" ShadowDepth="5" BlurRadius="22" Opacity="0.15" Direction="270"/>
    <Style x:Key="Glass" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource GlassFill}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="23"/>
      <Setter Property="Padding" Value="19"/>
      <Setter Property="Effect" Value="{StaticResource GlassShadow}"/>
    </Style>
    <Style x:Key="Action" TargetType="Button">
      <Setter Property="Background" Value="#BAFFFFFF"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="15,8"/>
      <Setter Property="MinHeight" Value="37"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="11" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.86"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#7291FC"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Mode" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Face" CornerRadius="8" Background="Transparent" Padding="14,7"
                    BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#72FFFFFF"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Face" Property="Background" Value="#F6FFFFFF"/>
                <Setter TargetName="Face" Property="BorderBrush" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#7291FC"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.62"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#AFFFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#C8DDE8FB"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ProgressStyle" TargetType="ProgressBar">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="3" Background="#C9DEE6F7"/>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Blue}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="28">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grip" CornerRadius="3" Background="#8296AAD0" Margin="2,1,3,1"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#BD849CCB"/></Trigger>
                          <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#DD6F88BD"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GlassCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="#BDFFFFFF"/>
      <Setter Property="MinHeight" Value="39"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EDF2FE"/></Trigger>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#DFE9FF"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="ComboFace" Background="{TemplateBinding Background}" BorderBrush="{StaticResource GlassEdge}"
                      BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}">
                <Grid>
                  <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    VerticalAlignment="Center" Margin="0,0,18,0" IsHitTestVisible="False"/>
                  <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource Muted}" StrokeThickness="1.3"
                        StrokeLineJoin="Round" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
              </Border>
              <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="Fade">
                <Border Background="#FFFAFCFF" CornerRadius="11" BorderBrush="#CED9EE" BorderThickness="1"
                        Margin="0,3,0,0" Padding="4" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFace" Property="BorderBrush" Value="#7291FC"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboFace" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border BorderBrush="#CFDAEE" BorderThickness="1">
    <Grid Background="{StaticResource Backdrop}">
      <Grid IsHitTestVisible="False" ClipToBounds="True">
        <Rectangle>
          <Rectangle.Fill>
            <RadialGradientBrush Center="0.94,0.17" GradientOrigin="0.94,0.17" RadiusX="0.66" RadiusY="0.74">
              <GradientStop Color="#B0AABFFF" Offset="0"/>
              <GradientStop Color="#619FBAFF" Offset="0.50"/>
              <GradientStop Color="#009FBAFF" Offset="1"/>
            </RadialGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
          <Rectangle.Fill>
            <RadialGradientBrush Center="0.04,0.76" GradientOrigin="0.04,0.76" RadiusX="0.75" RadiusY="0.78">
              <GradientStop Color="#A6A7DFE8" Offset="0"/>
              <GradientStop Color="#52B2DFEE" Offset="0.50"/>
              <GradientStop Color="#00B2DFEE" Offset="1"/>
            </RadialGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Ellipse HorizontalAlignment="Right" VerticalAlignment="Top" Width="640" Height="410" Margin="0,-89,-153,0" StrokeThickness="1.3">
          <Ellipse.RenderTransform><RotateTransform Angle="-24" CenterX="320" CenterY="205"/></Ellipse.RenderTransform>
          <Ellipse.Stroke>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#D0FFFFFF" Offset="0"/>
              <GradientStop Color="#65FFFFFF" Offset="0.50"/>
              <GradientStop Color="#07FFFFFF" Offset="1"/>
            </LinearGradientBrush>
          </Ellipse.Stroke>
        </Ellipse>
        <Ellipse HorizontalAlignment="Right" VerticalAlignment="Top" Width="662" Height="426" Margin="0,-95,-171,0" Stroke="#6FFFFFFF" StrokeThickness="1">
          <Ellipse.RenderTransform><RotateTransform Angle="-24" CenterX="331" CenterY="213"/></Ellipse.RenderTransform>
        </Ellipse>
      </Grid>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="47"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="27,0,11,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="25" Height="25" Background="{StaticResource Blue}" CornerRadius="8" BorderThickness="1" BorderBrush="#6E8EF1">
              <Path Data="M 0 5 L 3 5 L 5 1 L 8 9 L 10 5 L 14 5" Stroke="White" StrokeThickness="1.35"
                    StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="NetPulse" FontWeight="Bold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="최소화" AutomationProperties.Name="최소화"/>
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="최대화 / 복원" AutomationProperties.Name="최대화 / 복원"/>
            <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Content="&#xE8BB;" ToolTip="닫기" AutomationProperties.Name="닫기"/>
          </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
          </ScrollViewer.Resources>
          <StackPanel Margin="37,18,37,26">
            <Grid Margin="1,0,1,23">
              <StackPanel>
                <TextBlock Text="네트워크 모니터" FontSize="41" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                <TextBlock Text="Mesh 경유와 직접 Wi‑Fi에서 지연과 손실을 측정합니다." Foreground="{StaticResource Muted}" Margin="1,6,0,0"/>
              </StackPanel>
              <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="13,8" CornerRadius="16"
                      Background="{StaticResource GlassFill}" BorderThickness="1" BorderBrush="{StaticResource GlassEdge}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="#8491AC" Margin="0,0,8,0"/>
                  <TextBlock x:Name="StateText" Text="대기 중" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>
              </Border>
            </Grid>
            <Border Style="{StaticResource Glass}" Padding="18,13" Margin="0,0,0,22">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="연결 방식" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="2,0,0,6"/>
                    <Border Background="#83D9E4F9" CornerRadius="11" Padding="3">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="MeshMode" GroupName="Mode" IsChecked="True" Style="{StaticResource Mode}" Content="Mesh 경유"/>
                        <RadioButton x:Name="WifiMode" GroupName="Mode" Style="{StaticResource Mode}" Content="직접 Wi‑Fi"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="24,0,0,0">
                    <TextBlock Text="측정 시간" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="2,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                      <Border Background="#E7FFFFFF" CornerRadius="9" Padding="7,3" Height="38" BorderThickness="1" BorderBrush="White">
                        <TextBox x:Name="MinutesBox" Width="42" Text="10" MaxLength="3" BorderThickness="0" Background="Transparent"
                                 FontSize="16" FontWeight="SemiBold" TextAlignment="Center" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="측정 시간 (분)"/>
                      </Border>
                      <TextBlock Text="분" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="MarkButton" Style="{StaticResource Action}" Content="증상 표시" IsEnabled="False" Margin="0,0,8,0"
                            ToolTip="끊김을 체감한 시각을 현재 측정에 저장합니다."/>
                    <Button x:Name="StopButton" Style="{StaticResource Action}" Content="중지 및 저장" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button x:Name="StartButton" Style="{StaticResource Action}" Background="{StaticResource Blue}"
                            Foreground="White" MinWidth="112" BorderBrush="#5378EC" AutomationProperties.Name="측정 시작">
                      <StackPanel Orientation="Horizontal">
                        <Path Data="M 0 0 L 0 8 L 7 4 Z" Fill="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="측정 시작"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="ModeHint" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,9,0,0"/>
              </StackPanel>
            </Border>
            <DockPanel LastChildFill="False" Margin="2,0,2,10">
              <TextBlock DockPanel.Dock="Left" Text="실시간 측정" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
              <TextBlock DockPanel.Dock="Right" Text="1초 간격  ·  800 ms 응답 제한  ·  최근 60초"
                         FontSize="12.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid x:Name="CardsHost" Margin="0,0,0,16"/>
            <Border Style="{StaticResource Glass}" Padding="17,12" Margin="0,0,0,15">
              <StackPanel>
                <DockPanel>
                  <TextBlock x:Name="ElapsedText" DockPanel.Dock="Right" Text="00:00 / 10:00" Foreground="{StaticResource Accent}" FontSize="15"
                             FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                  <TextBlock x:Name="RoundsText" Text="측정 대기 중" FontWeight="SemiBold" FontSize="13"/>
                </DockPanel>
                <ProgressBar x:Name="Progress" Style="{StaticResource ProgressStyle}" Height="6" Margin="0,8,0,7" Minimum="0" Maximum="100"/>
                <TextBlock x:Name="DetailText" Text="손실이 감지되면 마지막 손실 시각과 대상을 표시합니다."
                           FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <DockPanel LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="FolderButton" Style="{StaticResource Action}" Content="결과 폴더" Margin="0,0,8,0"/>
                <Button x:Name="CompareButton" Style="{StaticResource Action}" Content="결과 비교" Margin="0,0,8,0"/>
                <Button x:Name="AnalysisButton" Style="{StaticResource Action}" Content="끊김 분석"/>
              </StackPanel>
              <TextBlock x:Name="SaveText" Text="측정 종료 후 끊김 분석에서 회차와 링크 기록을 확인할 수 있습니다."
                         FontSize="12.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                         Margin="2,0,12,0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
