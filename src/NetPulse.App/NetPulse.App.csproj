<Project Sdk="Microsoft.NET.Sdk">
  <!-- WinUI 3 앱 (D1). 패키지 없는 배포, 런타임 포함. 단일 파일 배포는 build/build.ps1이 EnableMsixTooling을 켜서 만든다. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <AssemblyName>NetPulse</AssemblyName>
    <RootNamespace>NetPulse.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 앱·트레이 아이콘 (M9). tools/make-icon.ps1로 만든다 -->
    <ApplicationIcon>Assets\NetPulse.ico</ApplicationIcon>
    <!-- 단일 파일 묶음은 압축하지 않는다: 이진 검사가 묶음 안 내용을 그대로 본다 (설계 B4) -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <ProjectReference Include="..\NetPulse.Core\NetPulse.Core.csproj" />
    <ProjectReference Include="..\NetPulse.Platform\NetPulse.Platform.csproj" />
    <ProjectReference Include="..\NetPulse.Design\NetPulse.Design.csproj" />
    <!-- 글꼴(Pretendard, SIL OFL)과 데모 시나리오. 단일 파일 배포에서는 실행 파일 안에 묶여 실행 시 풀린다
         (Windows App SDK가 IncludeAllContentForSelfExtract를 강제하고, AppContext.BaseDirectory가 풀린 폴더를 가리킨다).
         실행 파일의 해시가 이 파일들을 덮는다. -->
    <Content Include="..\..\assets\fonts\*.otf;..\..\assets\fonts\OFL-Pretendard.txt" Link="Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\NetPulse.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 사용 조건·라이선스·제3자 고지 (M10 설계 A2·A3): 앱 안에 내장해 exe 하나로도 보인다. LICENSE는 저장소 루트 파일 하나만 둔다 -->
    <None Remove="Legal/**" />
    <Content Remove="Legal/**" />
    <EmbeddedResource Include="Legal\TERMS.txt" LogicalName="NetPulse.Legal.TERMS.txt" />
    <EmbeddedResource Include="Legal\THIRD-PARTY-NOTICES.txt" LogicalName="NetPulse.Legal.THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="..\..\LICENSE" Link="Legal\LICENSE.txt" LogicalName="NetPulse.Legal.LICENSE.txt" />
    <Content Include="..\..\demo\scenarios\*.json" Link="demo\scenarios\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- 단일 파일 묶음에 실제로 들어가는 파일 목록 (M10 설계 B4·고지 수집 [2-5]). SDK는 묶을 항목을 ResolvedFileToPublish에서 빼서
       FilesToBundle로 옮기므로 PrepareForBundle 뒤·GenerateSingleFileBundle 앞에서 읽는다. publish마다 새로 쓴다(비공개, obj 아래). -->
  <Target Name="WriteBundleInputs" AfterTargets="PrepareForBundle" BeforeTargets="GenerateSingleFileBundle" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_NetPulseBundleLine Include="@(FilesToBundle->'%(RelativePath)&#9;%(FullPath)&#9;%(NuGetPackageId)&#9;%(NuGetPackageVersion)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)bundle-inputs.tsv" Lines="@(_NetPulseBundleLine)" Overwrite="true" />
  </Target>
  <!-- M0에서는 App.xbf와 앱 .pri를 배포 폴더로 직접 복사했다. M10: 배포 exe 하나만으로 전체 UI 시험이 돌므로 복사하지 않는다
       (설계 B2. build/ui-test.ps1은 app/에 exe 하나만 있을 때만 돈다). -->
</Project>
