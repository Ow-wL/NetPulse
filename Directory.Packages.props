<Project>
  <!-- 패키지 버전은 여기서만 정한다. 제품 런타임 의존성을 더하려면 사용자 승인이 필요하다 (docs/loop-plan.md 4.5). -->
  <ItemGroup>
    <!-- 제품 런타임 (D1 승인) -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageVersion Include="System.Diagnostics.EventLog" Version="10.0.3" />
    <!-- 빌드·테스트 전용 -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
