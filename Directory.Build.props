<Project>
  <!-- 모든 프로젝트 공통 설정 -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Company>NetPulse</Company>
    <Product>NetPulse</Product>
    <Version>1.0.0</Version>
    <Copyright>Copyright (c) 2026 Ow-wL</Copyright>
  </PropertyGroup>
  <!-- 배포(Release)는 로컬에서도 CI처럼 소스 경로를 정규화하고(/_/) 디버그 정보를 넣지 않는다 (M10 설계 B4).
       배포 파일에 이 PC의 경로가 들어가지 않게 하려는 것이다. Debug는 그대로다. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(Configuration)' == 'Release'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
